# Copy to .env on the SERVER and fill in. .env is never committed. Never paste these values into chat, a ticket or a commit.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<set by the owner on the server only>
# also stored in each Supabase project's Vault as reader_secret; at least 16 random characters
READER_WEBHOOK_SECRET=<long random text>
# the public name of this server, for the HTTPS certificate (a name that points at the server)
READER_DOMAIN=reader.example.com
# paddle (real) or stub (returns nothing, for a first check that the wiring works)
READER_ENGINE=paddle
READER_MAX_CONCURRENCY=2
