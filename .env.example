# Copy to .env and fill in locally. Never commit real values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side / Edge Functions only. Never ship in an app or browser.
SUPABASE_SERVICE_ROLE_KEY=
EXPO_ACCESS_TOKEN=
# send-push Edge Function (set with `supabase secrets set`, never commit a real value)
PUSH_DISPATCH_SECRET=
# Admin portal second step (Edge Function admin-2fa, sends through Brevo). Set with `supabase secrets set`, never commit real values.
# Brevo v3 API key (starts with xkeysib-), not an SMTP key
ADMIN_MAIL_API_KEY=
# A sender verified in Brevo, for example: DHA Works <staff@your-domain>
ADMIN_MAIL_FROM=
# LOCAL ONLY: prints the admin code in the function log instead of emailing it. Ignored for any hosted address.
# ADMIN_MAIL_MODE=dev-log

# Admin portal sign-in bot check (Cloudflare Turnstile). Site key is public; the secret is server-only (set it in Vercel, never commit it).
# A production build without the secret refuses every sign-in. Cloudflare's published test keys are for local runs only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TEST ONLY: shortens the admin idle logout (5 to 1800 seconds). Leave unset in real deployments (default 30 minutes).
# IDLE_LIMIT_SECONDS=
